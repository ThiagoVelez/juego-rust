#![enable(implicit_some)]
// Recetas de SurvivalForest. Formas propias (ninguna repite la de otro juego: lo comprueba
// la prueba `no_forbidden_shapes`). Las de 2×2 se hacen también en el inventario.
(
    crafting: [
        (id: "planks", kind: Shapeless(["log"]), output: ("planks", 3)),
        (id: "planks_bamboo", kind: Shapeless(["guadua", "guadua"]), output: ("planks", 1)),
        (id: "stick", kind: Shapeless(["planks"]), output: ("stick", 3)),
        (id: "crafting_table", kind: Shaped(rows: ["PP", "LL"], key: [('P', "planks"), ('L', "log")]), output: ("crafting_table", 1)),
        (id: "torch_coal", kind: Shapeless(["coal", "stick"]), output: ("torch", 4)),
        (id: "torch_charcoal", kind: Shapeless(["charcoal", "stick"]), output: ("torch", 4)),
        (id: "furnace", kind: Shaped(rows: ["KKK", "C C", "CCC"], key: [('K', "clay"), ('C', "cobble")]), output: ("furnace", 1)),
        (id: "chest", kind: Shaped(rows: ["PPP", "PIP", "PPP"], key: [('P', "planks"), ('I', "copper_ingot")]), output: ("chest", 1)),
        (id: "grindstone", kind: Shaped(rows: ["SQS", "CCC"], key: [('S', "stick"), ('Q', "quartz"), ('C', "cobble")]), output: ("grindstone", 1)),
        (id: "bricks", kind: Shaped(rows: ["BK", "KB"], key: [('B', "brick"), ('K', "clay")]), output: ("bricks", 2)),
        (id: "roof_tile", kind: Shaped(rows: ["K K", " K "], key: [('K', "clay")]), output: ("roof_tile", 3)),
        (id: "whitewash", kind: Shapeless(["sand", "clay", "cobble"]), output: ("whitewash", 2)),
        (id: "pick_wood", kind: Shaped(rows: ["M M", "MSM", " S "], key: [('M', "planks"), ('S', "stick")]), output: ("pick_wood", 1)),
        (id: "pick_stone", kind: Shaped(rows: ["M M", "MSM", " S "], key: [('M', "cobble"), ('S', "stick")]), output: ("pick_stone", 1)),
        (id: "pick_copper", kind: Shaped(rows: ["M M", "MSM", " S "], key: [('M', "copper_ingot"), ('S', "stick")]), output: ("pick_copper", 1)),
        (id: "pick_iron", kind: Shaped(rows: ["M M", "MSM", " S "], key: [('M', "iron_ingot"), ('S', "stick")]), output: ("pick_iron", 1)),
        (id: "axe_wood", kind: Shaped(rows: ["MMM", "MS ", "S  "], key: [('M', "planks"), ('S', "stick")]), output: ("axe_wood", 1)),
        (id: "axe_stone", kind: Shaped(rows: ["MMM", "MS ", "S  "], key: [('M', "cobble"), ('S', "stick")]), output: ("axe_stone", 1)),
        (id: "axe_copper", kind: Shaped(rows: ["MMM", "MS ", "S  "], key: [('M', "copper_ingot"), ('S', "stick")]), output: ("axe_copper", 1)),
        (id: "axe_iron", kind: Shaped(rows: ["MMM", "MS ", "S  "], key: [('M', "iron_ingot"), ('S', "stick")]), output: ("axe_iron", 1)),
        (id: "shovel_wood", kind: Shaped(rows: ["MM", "S ", "S "], key: [('M', "planks"), ('S', "stick")]), output: ("shovel_wood", 1)),
        (id: "shovel_stone", kind: Shaped(rows: ["MM", "S ", "S "], key: [('M', "cobble"), ('S', "stick")]), output: ("shovel_stone", 1)),
        (id: "shovel_copper", kind: Shaped(rows: ["MM", "S ", "S "], key: [('M', "copper_ingot"), ('S', "stick")]), output: ("shovel_copper", 1)),
        (id: "shovel_iron", kind: Shaped(rows: ["MM", "S ", "S "], key: [('M', "iron_ingot"), ('S', "stick")]), output: ("shovel_iron", 1)),
        (id: "machete_wood", kind: Shaped(rows: ["  M", " M ", "S  "], key: [('M', "planks"), ('S', "stick")]), output: ("machete_wood", 1)),
        (id: "machete_stone", kind: Shaped(rows: ["  M", " M ", "S  "], key: [('M', "cobble"), ('S', "stick")]), output: ("machete_stone", 1)),
        (id: "machete_copper", kind: Shaped(rows: ["  M", " M ", "S  "], key: [('M', "copper_ingot"), ('S', "stick")]), output: ("machete_copper", 1)),
        (id: "machete_iron", kind: Shaped(rows: ["  M", " M ", "S  "], key: [('M', "iron_ingot"), ('S', "stick")]), output: ("machete_iron", 1)),
    ],
    smelting: [
        (input: "copper_ore_item", output: "copper_ingot", xp: 1.0),
        (input: "iron_ore_item", output: "iron_ingot", xp: 1.0),
        (input: "gold_ore_item", output: "gold_ingot", xp: 1.5),
        (input: "sand", output: "glass", xp: 0.2),
        (input: "red_sand", output: "glass", xp: 0.2),
        (input: "clay", output: "brick", xp: 0.3),
        (input: "platano", output: "platano_asado", xp: 0.35),
        (input: "log", output: "charcoal", xp: 0.15),
        (input: "cobble", output: "stone", xp: 0.1),
    ],
)
